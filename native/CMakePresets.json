{
  "version": 3,
  "configurePresets": [
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm64-v8a",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-21",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-armv7",
      "displayName": "Android armeabi-v7a (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/armeabi-v7a",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "armeabi-v7a",
        "ANDROID_PLATFORM": "android-21",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 模拟器 (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x86_64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "x86_64",
        "ANDROID_PLATFORM": "android-21",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "android-arm64", "configurePreset": "android-arm64" },
    { "name": "android-armv7", "configurePreset": "android-armv7" },
    { "name": "android-x86_64", "configurePreset": "android-x86_64" }
  ]
}
